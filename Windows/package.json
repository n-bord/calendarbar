{
  "name": "calendarbar",
  "productName": "CalendarBar",
  "version": "0.6.4",
  "description": "Календарь и встречи Яндекс Календаря",
  "author": "nbord",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.nbord.CalendarBar",
    "asar": true,
    "directories": {
      "output": "../dist/windows"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "include": "assets/installer.nsh",
      "installerLanguages": [
        "ru_RU",
        "en_US"
      ],
      "language": "1049",
      "artifactName": "CalendarBar-Windows-${version}-x64-Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "sax": "1.6.1"
  }
}
