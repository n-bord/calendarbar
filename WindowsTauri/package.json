{
  "name": "calendarbar-tauri",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare:frontend": "node scripts/prepare-frontend.cjs",
    "start:electron": "npm run prepare:frontend && node scripts/start-electron.cjs",
    "build:windows": "tauri build --target x86_64-pc-windows-msvc --bundles nsis",
    "build:windows:per-user": "tauri build --target x86_64-pc-windows-msvc --bundles nsis --config src-tauri/tauri.per-user.conf.json"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4"
  }
}
